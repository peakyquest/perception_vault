<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_euclidean_cluster</name>
  <version>1.0.0</version>
  <description>
    ROS 2 node for performing Euclidean clustering on LiDAR point clouds.
    This package uses PCL (Point Cloud Library) to segment point clouds into
    distinct clusters based on Euclidean distance, with configurable cluster
    tolerance and size constraints.
  </description>
  <maintainer email="haroon300@hotmail.com">Haroon Rasheed</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>

  <!-- PCL dependency -->
  <depend>libpcl-all-dev</depend>

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
